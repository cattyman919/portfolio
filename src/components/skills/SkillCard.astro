---
import SkillCardItem from "./SkillCardItem.astro";
import { Icon } from "astro-icon/components";
import type { SkillsLine } from "@/types";

interface Props {
  skillLine: SkillsLine;
  reverse?: boolean;
}

const { skillLine, reverse = false } = Astro.props;

const { title, logo, skills } = skillLine;

// Duplicate the array to create the seamless infinite scroll illusion
const duplicatedSkills: SkillsLine["skills"] = skills.map((skill) => [
  ...skill,
  ...skill,
]);
---

<div
  class="flex flex-col group border border-primary/50 hover:border-primary transform-all duration-500 rounded-xl gap-10 py-6 w-full relative overflow-hidden"
>
  <div
    class="absolute inset-0 pointer-events-none bg-gradient-to-br from-primary/10 via-transparent to-primary/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
  >
  </div>

  {
    /* Gradient Masks to fade the left and right edges smoothly into the background */
  }

  <div
    class="absolute inset-y-0 left-0 w-24 md:w-40 bg-linear-to-r from-bg to-transparent z-10 pointer-events-none"
  >
  </div>
  <div
    class="absolute inset-y-0 right-0 w-24 md:w-40 bg-linear-to-l from-bg to-transparent z-10 pointer-events-none"
  >
  </div>

  <div class="flex gap-4 items-center px-8 md:px-10 relative z-20">
    {
      logo ? (
        <div class="flex items-center justify-center p-1 rounded-xl border border-white/10 text-primary drop-shadow-[0_0_8px_var(--color-primary)]">
          <Icon name={logo} class="w-11 h-11 " />
        </div>
      ) : (
        <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-white/5 border border-white/10 text-3xl font-bold text-primary drop-shadow-[0_0_8px_var(--color-primary)]">
          {title.charAt(0)}
        </div>
      )
    }
    <h3 class="font-bold text-xl md:text-4xl text-gray-300">{title}</h3>
  </div>

  {/* The Scrolling Track */}

  {
    duplicatedSkills.map((skill, index) => {
      let isRowReversed = reverse;

      if (index % 2 === 0) {
        isRowReversed = true;
      }

      const animationClass = isRowReversed
        ? "animate-marquee-reverse"
        : "animate-marquee";
      return (
        <div
          class={`flex w-max gap-6 hover:[animation-play-state:paused] ${animationClass} px-4`}
        >
          {skill.map((skillLine) => (
            <SkillCardItem
              name={skillLine.name}
              expertise={skillLine.expertise}
              logo={skillLine.logo}
            />
          ))}
        </div>
      );
    })
  }
</div>
