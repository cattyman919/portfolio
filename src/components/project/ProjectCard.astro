---
import type { Project } from "@/types";
import TiltWrapper from "@/components/TiltWrapper";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, image, description, type, tools, demoURL, sourceCodeURL } =
  project;
---

<div class="w-full h-full md:w-[450px] flex justify-center group">
  <TiltWrapper client:visible maxTilt={4} className="w-full h-full">
    <div
      class="w-full h-full p-2 rounded-2xl shadow-xl shadow-primary/30 bg-primary/50 group-hover:shadow-primary/50 group-hover:shadow-2xl group-hover:bg-primary/100 group-hover:-translate-y-5 transition-all duration-500 flex flex-col overflow-hidden"
    >
      <div
        class="bg-bg/98 w-full h-full flex flex-col overflow-hidden rounded-xl"
      >
        {
          image ? (
            <div class="w-full h-48 shrink-0 mb-4 bg-black overflow-hidden rounded-t-lg">
              <Image
                src={image}
                alt="Project Image"
                class="w-full h-full object-cover rounded-t-lg shrink-0 opacity-80 group-hover:opacity-100 group-hover:scale-110 cursor-pointer transition-all duration-500"
              />
            </div>
          ) : (
            <div class="w-full h-48 rounded-t-lg shrink-0 mb-4 bg-white/5 border border-white/10 flex items-center justify-center">
              <span class="text-gray-500 font-bold tracking-widest text-sm">
                NO IMAGE
              </span>
            </div>
          )
        }

        {/* Text Group */}
        <div class="w-full h-full flex flex-col px-6 py-4">
          <div class="flex flex-col flex-1">
            <div class="flex flex-col gap-5">
              <div class="flex justify-between">
                <h1 class="font-bold text-2xl">{title}</h1>
                <p class="border border-primary px-4 py-1 rounded-lg">{type}</p>
              </div>
              <p class="text-justify text-lg/loose text-gray-200">
                {description}
              </p>
              <div>
                <p class="font-bold mb-3 text-gray-300/70">Tools</p>
                {
                  tools &&
                    tools.map((tool) => (
                      <div class="flex gap-4">
                        {tool.logo ? (
                          <div class="flex items-center justify-center p-1 rounded-lg border border-white/10 text-primary ">
                            <Icon name={tool.logo} class="w-10 h-10 " />
                          </div>
                        ) : (
                          <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-white/5 border border-white/10 text-3xl font-bold text-primary drop-shadow-[0_0_8px_var(--color-primary)]">
                            {title.charAt(0)}
                          </div>
                        )}
                      </div>
                    ))
                }
              </div>
            </div>

            {/* Buttons Group */}
            <div class="flex flex-col gap-3 mt-auto">
              <div class="flex justify-between gap-8 mt-5">
                {/* Live Demo Button */}
                <a
                  href={demoURL || undefined}
                  target={demoURL ? "_blank" : undefined}
                  rel={demoURL ? "noopener noreferrer" : undefined}
                  class={`border py-4 px-8 rounded-lg flex gap-2 justify-center items-center transition-all ${
                    demoURL
                      ? "cursor-pointer border-primary/50"
                      : "opacity-40 cursor-not-allowed pointer-events-none border-gray-600 text-gray-500"
                  }`}
                >
                  <Icon name="mdi:world-wide-web" class="w-8 h-8" />
                  <p class="font-bold">Live Demo</p>
                </a>

                {/* Source Code Button */}
                <a
                  href={sourceCodeURL || undefined}
                  target={sourceCodeURL ? "_blank" : undefined}
                  rel={sourceCodeURL ? "noopener noreferrer" : undefined}
                  class={`border py-4 px-8 rounded-lg flex gap-2 justify-center items-center transition-all ${
                    sourceCodeURL
                      ? "cursor-pointer border-primary/50"
                      : "opacity-40 pointer-events-none border-gray-600 text-gray-500"
                  }`}
                >
                  <Icon name="mdi:code-tags" class="w-8 h-8" />
                  <p class="font-bold">Source</p>
                </a>
              </div>
              <a
                class="cursor-pointer px-4 py-3 border border-primary/50 rounded-lg text-center font-bold"
                >Read more details...</a
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </TiltWrapper>
</div>
