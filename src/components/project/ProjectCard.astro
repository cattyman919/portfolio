---
import type { Project } from "@/types";
import TiltWrapper from "@/components/TiltWrapper";
import { Icon } from "astro-icon/components";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, type, tools } = project;
---

<div class="w-full h-full md:w-[450px] flex justify-center">
  <TiltWrapper
    client:visible
    maxTilt={4}
    className="p-2 rounded-2xl shadow-xl shadow-primary/30 bg-primary/80 border-2 border-primary group "
  >
    <div
      class="bg-bg/98 w-full h-full px-6 py-4 flex flex-col gap-4 justify-between"
    >
      <div>
        <h1>Image</h1>
        <div class="flex justify-between">
          <h1 class="font-bold text-2xl">{title}</h1>
          <p class="border border-primary px-4 py-1 rounded-lg">{type}</p>
        </div>
        <p class="text-justify text-lg/loose text-gray-200">{description}</p>
      </div>
      <div>
        <p class="font-bold mt-5 text-gray-300/70">Tools</p>
        {
          tools &&
            tools.map((tool) => (
              <div class="flex gap-4">
                {tool.logo ? (
                  <div class="flex items-center justify-center p-1 rounded-lg border border-white/10 text-primary ">
                    <Icon name={tool.logo} class="w-10 h-10 " />
                  </div>
                ) : (
                  <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-white/5 border border-white/10 text-3xl font-bold text-primary drop-shadow-[0_0_8px_var(--color-primary)]">
                    {title.charAt(0)}
                  </div>
                )}
              </div>
            ))
        }
      </div>
      <div class="flex flex-col gap-3">
        <div class="flex justify-between gap-8 mt-5">
          <button class="flex gap-2 justify-center items-center">
            <Icon name="mdi:world-wide-web" class="w-8 h-8" />
            <p>Live Demo</p>
          </button>
          <button class="flex gap-2 justify-center items-center">
            <Icon name="mdi:code-tags" class="w-8 h-8" />
            <p>Source</p>
          </button>
        </div>
        <a
          href="#"
          class="px-4 py-3 border border-primary rounded-lg text-center"
          >Read more details...</a
        >
      </div>
    </div>
  </TiltWrapper>
</div>
