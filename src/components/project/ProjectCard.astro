---
import type { CollectionEntry } from "astro:content";
import TiltWrapper from "@/components/TiltWrapper";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

interface Props {
  project: CollectionEntry<"projects">;
}

const MAX_TECH_LENGTH: number = 6;
const { project } = Astro.props;
const { title, image, description, type, tools, demoUrl, sourceCodeUrl } =
  project.data;
---

<div class="w-full h-full md:w-[450px] flex justify-center group">
  <TiltWrapper client:visible maxTilt={4} className="w-full h-full">
    <div
      class="w-full h-full p-2 rounded-2xl shadow-xl shadow-primary/30 bg-primary/50 group-hover:shadow-primary/50 group-hover:shadow-2xl group-hover:bg-primary/100 group-hover:-translate-y-5 transition-all duration-500 flex flex-col overflow-hidden"
    >
      <div
        class="bg-bg/98 w-full h-full flex flex-col overflow-hidden rounded-xl"
      >
        <a
          href={`/project/${project.id}`}
          class="relative w-full h-48 group/image cursor-pointer"
          data-astro-prefetch
        >
          {
            image ? (
              <div class="w-full h-48 shrink-0 mb-4 bg-black overflow-hidden rounded-t-lg">
                {image.format === "gif" ? (
                  <img
                    src={image.src}
                    alt="Project Image"
                    class="w-full h-full object-cover rounded-t-lg shrink-0 opacity-80 group-hover:opacity-100 group-hover:scale-110 group-hover/image:blur-xs cursor-pointer transition-all duration-500"
                  />
                ) : (
                  <Image
                    format="avif"
                    src={image}
                    alt="Project Image"
                    class="w-full h-full object-cover rounded-t-lg shrink-0 opacity-80 group-hover:opacity-100 group-hover:scale-110 group-hover/image:blur-xs cursor-pointer transition-all duration-500"
                  />
                )}
              </div>
            ) : (
              <div class="w-full h-48 rounded-t-lg shrink-0 mb-4 bg-white/5 border border-white/10 flex items-center justify-center">
                <span class="text-gray-500 font-bold tracking-widest text-sm">
                  NO IMAGE
                </span>
              </div>
            )
          }
          <div
            class="absolute inset-0 bg-black/30 flex items-center justify-center opacity-0 group-hover/image:opacity-100 transition-opacity duration-300"
          >
            <p class="font-bold text-white text-center text-lg px-4">
              Click for more info
            </p>
          </div>
        </a>

        {/* Text Group */}
        <div class="w-full h-full flex flex-col px-6 py-4">
          <div class="flex flex-col flex-1">
            <div class="flex flex-col gap-5">
              <div
                class="flex flex-col gap-4 md:flex-row md:gap-0 md:justify-between"
              >
                <a
                  href={`projects/${project.id}`}
                  class="flex relative gap-2 group/title font-bold text-2xl text-primary/90 hover:text-primary/100 hover:bg-transparent hover:border-none drop-shadow-none shadow-none cursor-pointer"
                >
                  <h1 class="font-pixel">{title}</h1>
                  <Icon
                    name="mdi:external-link"
                    class="absolute w-5 h-5 right-0 top-0 -translate-y-1 translate-x-[140%] opacity-0 group-hover/title:translate-x-[120%] group-hover/title:translate-y-1 group-hover/title:opacity-100 transition-all duration-300"
                  />
                </a>
                <p
                  class="border border-primary px-4 py-1 rounded-lg bg-primary/10 font-bold w-fit"
                >
                  {type}
                </p>
              </div>
              <p class="text-justify text-lg/loose text-gray-200 line-clamp-5">
                {description}
              </p>
              <div>
                <p class="font-bold mb-3 text-gray-300/70">Technologies</p>
                <div class="flex flex-wrap gap-2">
                  {
                    tools.slice(0, MAX_TECH_LENGTH).map((tool) => (
                      <div title={tool.name} class="flex gap-4">
                        {tool.logo ? (
                          <div class="flex items-center justify-center p-1 rounded-lg border border-white/20  hover:border-primary/70 transition-all duration-300 hover:bg-primary/10 hover:-translate-y-1 text-gray-100">
                            <Icon
                              name={tool.logo}
                              class="w-8 h-8 md:w-10 md:h-10 "
                            />
                          </div>
                        ) : (
                          <div class="flex items-center justify-center w-10 h-10 md:w-12 md:h-12 rounded-xl bg-white/5 border border-white/10 text-3xl font-bold text-primary drop-shadow-[0_0_8px_var(--color-primary)]">
                            {title.charAt(0)}
                          </div>
                        )}
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>

            {/* Buttons Group */}
            <div class="flex flex-col md:flex-row gap-3 mt-auto pt-8">
              {/* Live Demo Button */}
              <a
                href={demoUrl || undefined}
                target={demoUrl ? "_blank" : undefined}
                rel={demoUrl ? "noopener noreferrer" : undefined}
                class={`flex-1 border py-2 px-2 rounded-lg flex gap-2 justify-center items-center transition-all ${
                  demoUrl
                    ? "cursor-pointer border-primary/50"
                    : "opacity-40 cursor-not-allowed pointer-events-none border-gray-600 text-gray-500"
                }`}
              >
                {/* Added shrink-0 to prevent icon from squishing */}
                <Icon
                  name="mdi:world-wide-web"
                  class="w-6 h-6 sm:w-8 sm:h-8 shrink-0"
                />
                {/* Added whitespace-nowrap to prevent text wrapping */}
                <p class="font-bold whitespace-nowrap">Live Demo</p>
              </a>

              {/* Source Code Button */}
              <a
                href={sourceCodeUrl || undefined}
                target={sourceCodeUrl ? "_blank" : undefined}
                rel={sourceCodeUrl ? "noopener noreferrer" : undefined}
                class={`flex-1 border py-2 px-2 rounded-lg flex gap-2 justify-center items-center transition-all ${
                  sourceCodeUrl
                    ? "cursor-pointer border-primary/50"
                    : "opacity-40 pointer-events-none border-gray-600 text-gray-500"
                }`}
              >
                <Icon
                  name="mdi:code-tags"
                  class="w-6 h-6 sm:w-8 sm:h-8 shrink-0"
                />
                <p class="font-bold whitespace-nowrap">Source</p>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </TiltWrapper>
</div>
