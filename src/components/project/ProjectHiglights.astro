---
import { Icon } from "astro-icon/components";
import type { ProjectType } from "../../content.config";

interface Props {
  highlights: ProjectType["highlights"];
}

const { highlights } = Astro.props;
---

<div class="flex-1 px-0 md:px-8 py-4 flex flex-col gap-8">
  <div class="flex gap-2 items-center">
    <Icon name="lucide:star" class="w-6 h-6" />
    <h1 class="font-bold text-2xl md:text-4xl">Project Highlights</h1>
  </div>
  <div class="flex flex-col gap-8">
    {
      highlights.map((hightlight) => (
        <div class="flex gap-6 items-center text-justify border border-gray-200/20 hover:border-primary/30 px-4 py-2 rounded-md hover:bg-primary/5 transform-all duration-300">
          <div class="w-4 h-4 shadow-primary backdrop-brightness-75 shadow-xl drop-shadow-[0_0_3px_var(--color-primary)]   aspect-square rounded-full border bg-primary" />
          <p class="text-base md:text-xl leading-loose text-gray-100">
            {hightlight}
          </p>
        </div>
      ))
    }
  </div>
</div>
