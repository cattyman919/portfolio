---
import SkillCard from "./skills/SkillCard.astro";
import { skillsData } from "@/content/skills";
---

<section id="skills" class="min-h-screen px-6 md:px-20">
  <h1 class="font-bold text-6xl text-center mb-20 font-pixel">My SkillSet</h1>
  <div class="space-y-20">
    {
      skillsData.map((skillLine, index) => {
        var reverse = false;
        if (index % 2 === 1) {
          reverse = true;
        }
        return <SkillCard skillLine={skillLine} reverse={reverse} />;
      })
    }
  </div>
</section>
