---
import SkillCard from "./skills/SkillCard.astro"
import {skillsData} from "@/data/skills"
---

<section id="skills" class="min-h-screen px-8">
  <h1 class="font-bold text-6xl text-center mb-20 ">My SkillSet</h1>
  {skillsData.map((skillLine) => <SkillCard title={skillLine.title} skills={skillLine.skills}/>)}
</section>
