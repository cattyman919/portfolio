---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import SenoProfile from "@/assets/images/Jas Hitam Seno 2.png";
import UILogo from "@/assets/Makara_of_Universitas_Indonesia.png";
import TiltWrapper from "@/components/TiltWrapper";
---

<section id="about" class="min-h-screen">
  <h1 class="text-6xl font-bold text-center mb-20 font-pixel">Who Am I?</h1>
  <div
    class="flex flex-col-reverse md:flex-row items-center w-[90%] lg:w-[80%] mx-auto gap-12 lg:gap-20"
  >
    {/* LEFT SIDE */}
    <div class="w-full md:w-[60%] flex flex-col gap-6">
      <div class="flex gap-4 items-center">
        <div
          class="flex items-center justify-center
    w-12 h-12 rounded-full
    bg-white/5 backdrop-blur-md border border-white/10
    shadow-[0_0_30px_rgba(16,185,129,0.4)]"
        >
          <Icon
            name="lucide:user"
            class="w-8 h-8 text-emerald-400 drop-shadow-[0_0_10px_rgba(16,185,129,0.8)]"
          />
        </div>
        <h2 class="text-gray-300 text-2xl md:text-4xl font-bold">
          About <span class="text-gradient">The Developer</span>
        </h2>
      </div>
      <div
        class="text-gray-300 border border-white/5 bg-white/[0.02] backdrop-blur-3xl overflow-hidden shadow-2xl px-10 py-4 leading-relaxed tracking-widest text-justify rounded-md"
      >
        <!-- <p class="text-md/loose md:text-xl/loose italic"> -->
        <!--   My name is Seno Pamungkas Rahman. Im an avid software engineer with a -->
        <!--   zest for front-end, back-end, AI, and cloud technologies. Passionate -->
        <!--   about exploring new tech frontiers, I blend creativity with technical -->
        <!--   skill in every project, pushing the boundaries of software innovation -->
        <!-- </p> -->
        <p class="text-md/loose md:text-xl md:leading-12 italic">
          My name is Seno Pamungkas Rahman, a Computer Engineering graduate from
          Universitas Indonesia. I specialize in building highly concurrent
          systems, automating cloud infrastructure across AWS and GCP, and
          developing robust full-stack applications. Whether I am crafting
          terminal-driven CLI tools in Go and Rust, auditing Kubernetes
          clusters, or designing platforms with React, Next.js and NestJS, I am
          driven by a passion for creating efficient, secure, and scalable
          solutions.
        </p>
        <div
          class="absolute w-1 h-20 bg-gradient-to-b from-primary to-transparent left-0 top-0 rounded-full"
        >
        </div>
      </div>
      <div
        class="flex items-center gap-4 text-gray-300 border border-white/5 bg-white/[0.02] backdrop-blur-3xl overflow-hidden shadow-2xl px-5 py-4 leading-relaxed tracking-widest text-justify rounded-md"
      >
        <Image
          src={UILogo}
          alt="Logo Universitas Indonesia"
          class="w-16 h-16 md:w-18 md:h-18 object-contain"
          }
        />
        <div>
          <p class="text-md/loose md:text-xl/loose italic">
            <span class="text-primary/80 font-bold">Universitas Indonesia</span> -
            Computer Engineer
          </p>
          <p class="text-md/loose md:text-xl/loose italic">
            <span class="font-bold text-primary/80">GPA:</span> 3.78
          </p>
        </div>
        <div
          class="absolute w-1 h-20 bg-linear-to-b from-primary to-transparent right-0 top-0 rounded-full"
        >
        </div>
      </div>
    </div>

    {/* RIGHT SIDE */}
    <div class="w-full h-[500px] md:h-[650px] md:w-[40%] flex justify-center">
      <TiltWrapper
        client:visible
        maxTilt={15}
        className=" rounded-2xl shadow-2xl border-2 border-primary/20 group bg-white/[0.02] "
      >
        <Image
          src={SenoProfile}
          alt="Profile"
          class="w-full h-full drop-shadow-xl group-hover:translate-z-[50px] group-hover:drop-shadow-2xl grayscale group-hover:grayscale-0 transition-all duration-700 object-cover object-top"
          }
        />
        <h2
          class="absolute bottom-0 left-1/2 -translate-x-1/2 text-center w-[90%] text-xl font-bold bg-white/20 border border-white/5 text-gray-300 rounded-lg py-2 backdrop-blur-3xl opacity-0 group-hover:opacity-100 group-hover:bottom-[40px] transition-all duration-500 translate-z-[75px]"
        >
          Built With Passion
        </h2>
      </TiltWrapper>
    </div>
  </div>
</section>
