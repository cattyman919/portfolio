---
import { experienceData } from "@/data/experiences";
import ExperienceCard from "./experience/ExperienceCard.astro";
---

<section id="experience" class="min-h-screen py-20 relative">
  <h1 class="text-6xl font-bold text-center mb-20">My Journey</h1>

  <div id="experience-container" class="relative space-y-20 w-[80%] mx-auto">
    <div
      class="absolute top-0 w-[2px] rounded-full bg-white/[0.04] backdrop-blur-3xl h-full"
    >
    </div>

    <div
      id="experience-progress-line"
      class="absolute top-0 w-[2px] h-full rounded-full origin-top bg-primary shadow-[0_0_15px_var(--color-primary)] will-change-transform"
      style="transform: scaleY(0);"
    >
    </div>

    {experienceData.map((exp) => <ExperienceCard {...exp} />)}
  </div>
</section>

<script>
  const setupTimelineScroll = () => {
    const container = document.getElementById("experience-container");
    const line = document.getElementById("experience-progress-line");

    if (!container || !line) return;

    const updateLine = () => {
      // Get the exact position of the container relative to the screen
      const rect = container.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      // START point: When the top of the container hits 80% down the screen
      const startTrigger = viewportHeight * 0.8;

      // Calculate how far we've scrolled past that trigger point
      const scrolledPast = startTrigger - rect.top;

      // Calculate the progress percentage (0.0 to 1.0)
      let progress = scrolledPast / rect.height;

      // Clamp the value so it doesn't shrink backward or grow past 100%
      progress = Math.max(0, Math.min(1, progress));

      // Apply the scale!
      line.style.transform = `scaleY(${progress})`;
    };

    // Run it once immediately so it sets the correct height on page load
    updateLine();

    // Run it every time the user scrolls.
    // requestAnimationFrame ensures it runs perfectly synced with the monitor's refresh rate (60fps/120fps)
    window.addEventListener("scroll", () => {
      requestAnimationFrame(updateLine);
    });
  };

  // Initialize the script
  setupTimelineScroll();

  // If you are using Astro's ViewTransitions, this ensures the script re-runs when navigating between pages
  document.addEventListener("astro:page-load", setupTimelineScroll);
</script>
