---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { render } from "astro:content";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
  const blogs = await getCollection("blogs");
  return blogs.map((blog) => ({
    params: { id: blog.id },
    props: { blog: blog },
  }));
}

const { blog } = Astro.props;
const { Content, headings } = await render(blog);
---

<BaseLayout hideNav>
  <nav
    id="blog-nav"
    class="fixed top-0 left-0 right-0 z-50 h-[60px] flex items-center bg-black/20 backdrop-blur-lg border-b border-white/5 transition-transform duration-300"
  >
    <div
      class="max-w-7xl mx-auto px-6 w-full flex items-center justify-between relative z-10 bg-inherit"
    >
      <a
        href="/blog"
        class="flex items-center gap-2 text-primary/80 hover:text-primary font-bold transition-colors bg-transparent hover:bg-transparent hover:shadow-none"
      >
        <Icon name="lucide:arrow-left" class="w-5 h-5" />
        Back to Blog
      </a>

      <span
        class="hidden md:block text-sm font-bold text-gray-500 truncate max-w-md"
      >
        {blog.data.title}
      </span>

      <button
        id="mobile-toc-toggle"
        class="lg:hidden p-2 text-gray-400 hover:text-primary transition-colors cursor-pointer border-none"
        aria-label="Table of Contents"
      >
        <Icon name="lucide:list" class="w-6 h-6" />
      </button>
    </div>

    <div
      id="mobile-toc-menu"
      class="absolute top-[60px] left-0 w-full bg-black/95 backdrop-blur-xl border-b border-white/5 shadow-2xl transition-all duration-300 transform -translate-y-full opacity-0 hidden lg:hidden z-0"
    >
      <div class="p-6 flex flex-col gap-4 max-h-[70vh] overflow-y-auto">
        <h3 class="text-lg font-bold text-primary/80 font-pixel tracking-wide">
          Table of Contents
        </h3>
        <ul class="flex flex-col gap-3 text-sm">
          {
            headings.map((heading) => (
              <li
                style={`margin-left: ${Math.max(0, heading.depth - 2) * 1}rem`}
              >
                <a
                  href={`#${heading.slug}`}
                  class="toc-link mobile-toc-link text-gray-400 hover:text-primary/80 transition-all duration-300 bg-transparent hover:bg-transparent hover:shadow-none font-medium block py-1 line-clamp-2"
                >
                  {heading.text}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </nav>

  <div
    class="max-w-7xl mx-auto px-6 pt-24 pb-12 flex flex-col lg:flex-row gap-12 relative"
  >
    <article class="w-full lg:w-3/4 max-w-4xl blog-content text-gray-300">
      <header class="mb-10 flex flex-col gap-4">
        <h1 class="text-4xl md:text-5xl font-bold text-primary/80 font-pixel">
          {blog.data.title}
        </h1>

        <div class="flex gap-4 items-center text-sm text-gray-400">
          <p>
            {
              new Date(blog.data.pubDate).toLocaleDateString("en-US", {
                dateStyle: "long",
              })
            }
          </p>
          <div class="flex gap-2">
            {
              blog.data.tags?.map((tag: string) => (
                <span class="text-xs font-bold px-3 py-1 rounded-full bg-primary/10 text-primary/80 border border-primary/20">
                  #{tag}
                </span>
              ))
            }
          </div>
        </div>
      </header>

      <div class="content-wrapper">
        <Content />
      </div>
    </article>

    <aside class="hidden lg:block w-1/4 relative">
      <div
        class="sticky top-20 p-6 rounded-xl border border-white/5 bg-white/[0.02] backdrop-blur-md"
      >
        <h3
          class="text-xl font-bold text-primary/80 mb-4 font-pixel tracking-wide"
        >
          Table of Contents
        </h3>
        <ul class="flex flex-col gap-3 text-sm">
          {
            headings.map((heading) => (
              <li
                style={`margin-left: ${Math.max(0, heading.depth - 2) * 1}rem`}
              >
                <a
                  href={`#${heading.slug}`}
                  class="toc-link text-gray-400 hover:text-primary/80 transition-colors bg-transparent hover:bg-transparent hover:shadow-none font-medium line-clamp-2"
                >
                  {heading.text}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  // Logic to hide the navbar on scroll down, and show it on scroll up
  const setupSmartNav = () => {
    const nav = document.getElementById("blog-nav");
    if (!nav) return;

    let lastScroll = window.scrollY;

    window.addEventListener(
      "scroll",
      () => {
        const currentScroll = window.scrollY;

        if (currentScroll <= 0) {
          // Always show at the very top
          nav.classList.remove("-translate-y-full");
          return;
        }

        if (currentScroll > lastScroll && currentScroll > 60) {
          // Scrolling down past the header height -> Hide
          nav.classList.add("-translate-y-full");
        } else if (currentScroll < lastScroll) {
          // Scrolling up -> Show
          nav.classList.remove("-translate-y-full");
        }

        lastScroll = currentScroll;
      },
      { passive: true },
    ); // passive: true improves scroll performance
  };

  const setupMobileToC = () => {
    const toggleBtn = document.getElementById("mobile-toc-toggle");
    const menu = document.getElementById("mobile-toc-menu");
    const links = document.querySelectorAll(".mobile-toc-link");
    let isOpen = false;

    if (!toggleBtn || !menu) return;

    const toggleMenu = () => {
      isOpen = !isOpen;
      if (isOpen) {
        menu.classList.remove("hidden");
        // requestAnimationFrame allows the 'display: block' from removing 'hidden' to apply before animating
        requestAnimationFrame(() => {
          menu.classList.remove("-translate-y-full", "opacity-0");
        });
      } else {
        menu.classList.add("-translate-y-full", "opacity-0");
        // Wait for the CSS transition to finish before hiding from the DOM
        setTimeout(() => {
          menu.classList.add("hidden");
        }, 300);
      }
    };

    toggleBtn.addEventListener("click", toggleMenu);

    // Close the mobile menu automatically when a link is clicked
    links.forEach((link) => {
      link.addEventListener("click", () => {
        if (isOpen) toggleMenu();
      });
    });
  };

  // 2. Table of Contents Highlight Logic
  const setupToCHighlight = () => {
    // Grab all the links we just added the 'toc-link' class to
    const tocLinks = document.querySelectorAll(".toc-link");
    // Grab all the headings inside the markdown content
    const headings = document.querySelectorAll(
      ".content-wrapper h1, .content-wrapper h2, .content-wrapper h3, .content-wrapper h4",
    );

    if (!tocLinks.length || !headings.length) return;

    // Set up the observer to watch when headings hit the top 20% of the screen
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute("id");

            // Reset all links to their default inactive state
            tocLinks.forEach((link) => {
              link.classList.remove("text-primary", "translate-x-2");
              link.classList.add("text-gray-400");
            });

            // Highlight the currently intersecting link and push it slightly to the right
            const activeLink = document.querySelector(
              `.toc-link[href="#${id}"]`,
            );
            if (activeLink) {
              activeLink.classList.remove("text-gray-400");
              activeLink.classList.add("text-primary", "translate-x-2");
            }
          }
        });
      },
      {
        // Triggers when the heading is between the top 100px and the upper middle of the viewport
        rootMargin: "-100px 0px -70% 0px",
      },
    );

    // Tell the observer to watch every heading
    headings.forEach((heading) => observer.observe(heading));
  };

  // Run on initial load and handle Astro View Transitions if you ever enable them
  const initScripts = () => {
    setupSmartNav();
    setupToCHighlight();
    setupMobileToC();
  };

  initScripts();

  document.addEventListener("astro:page-load", initScripts);
</script>

<style is:global>
  /* Markdown Content Scoped Styling */

  .content-wrapper {
    /* Increase base font size slightly for better readability on modern screens */
    font-size: 1.125rem;
    line-height: 1.8;
    color: #d1d5db; /* Tailwind gray-300 */
    -webkit-font-smoothing: antialiased;
  }

  /* Headings: Tighter letter-spacing looks more modern */
  .content-wrapper h1,
  .content-wrapper h2,
  .content-wrapper h3,
  .content-wrapper h4 {
    font-family: var(--font-pixel);
    color: color-mix(in oklch, var(--color-primary) 95%, white);
    font-weight: 700;
    line-height: 1.3;
    margin-top: 2.5em;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .content-wrapper h1 {
    font-size: 2.5rem;
    letter-spacing: -0.025em;
  }

  .content-wrapper h2 {
    font-size: 2rem;
    /* Add a subtle underline to H2s to clearly separate major sections */
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 0.5rem;
  }

  .content-wrapper h3 {
    font-size: 1.5rem;
  }
  .content-wrapper h4 {
    font-size: 1.25rem;
  }

  /* Paragraphs: Left-aligned is better for web reading than justified */
  .content-wrapper p {
    margin-bottom: 1.75em;
    text-align: justify;
    letter-spacing: 0.01em;
    hyphens: auto;
    -webkit-hyphens: auto;
    -ms-hyphens: auto;
  }

  /* Links: Styled underline that highlights on hover */
  .content-wrapper a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: color-mix(
      in oklch,
      var(--color-primary) 40%,
      transparent
    );
    text-underline-offset: 4px;
    background: transparent !important;
    box-shadow: none !important;
    transition: text-decoration-color 0.2s ease;
  }
  .content-wrapper a:hover {
    text-decoration-color: var(--color-primary);
  }

  /* Lists: Added primary color to the bullets/numbers */
  .content-wrapper ul,
  .content-wrapper ol {
    margin-bottom: 1.75em;
    padding-left: 1.5em;
  }
  .content-wrapper ul {
    list-style-type: disc;
  }
  .content-wrapper ol {
    list-style-type: decimal;
  }
  .content-wrapper li {
    margin-bottom: 0.5em;
  }
  .content-wrapper li::marker {
    color: color-mix(in oklch, var(--color-primary) 80%, transparent);
  }

  /* Images: Nice rounded corners and subtle border */
  .content-wrapper img {
    border-radius: 0.75rem;
    margin: 2.5em auto;
    max-width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  /* Blockquotes: Larger, italicized, and distinguished */
  .content-wrapper blockquote {
    border-left: 4px solid var(--color-primary);
    padding: 1.25rem 1.5rem;
    font-style: italic;
    font-size: 1.25rem;
    color: #e5e7eb; /* Tailwind gray-200 */
    background: color-mix(in oklch, var(--color-primary) 5%, transparent);
    border-radius: 0 0.5rem 0.5rem 0;
    margin: 2.5em 0;
  }

  /* Code Blocks: Custom monospace stack and dark inner shadow */
  .content-wrapper pre {
    padding: 1.5em;
    border-radius: 0.75rem;
    overflow-x: auto;
    margin: 2em 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #0d1117 !important; /* Deep dark background */
    box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.5);
  }

  /* Inline Code */
  .content-wrapper code {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: color-mix(in oklch, var(--color-primary) 90%, white);
    background: rgba(255, 255, 255, 0.08);
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }

  .content-wrapper pre code {
    color: #e5e7eb;
    background: transparent;
    padding: 0;
    font-size: 0.9em;
  }
</style>
