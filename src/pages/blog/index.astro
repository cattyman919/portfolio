---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
---

<BaseLayout>
  <div class="px-20 mt-15">
    <div class="flex flex-col justify-center text-gray-200 gap-4">
      <h1 class="font-bold text-4xl font-pixel">Blog</h1>
      <p class="w-[40%] text-justify text-gray-400">
        Welcome to my blog domain where I share personal stories about things
        I've learned, projects I'm hacking on and just general findings.
      </p>
    </div>
  </div>
</BaseLayout>
