---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCardDetail from "@/components/project/ProjectCardDetail.astro";

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}
// 2. For your template, you can get the entry directly from the prop
const { project } = Astro.props;
const {
  title,
  description,
  highlights,
  tools,
  tags,
  demoUrl,
  sourceCodeUrl,
  image,
  mediaUrls,
} = project.data;
---

<BaseLayout>
  <div class="max-w-7xl mx-auto w-full flex flex-col gap-8 px-4 sm:px-6 py-8">
    <a href="/#projects" class="hover:text-primary transition-colors w-fit">
      <p>← Back to Projects</p>
    </a>
    <ProjectCardDetail
      description={description}
      title={title}
      demoUrl={demoUrl}
      mediaUrls={mediaUrls}
      sourceCodeUrl={sourceCodeUrl}
      image={image}
      tags={tags}
    />
  </div>
</BaseLayout>
