---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCardDetail from "@/components/project/ProjectCardDetail.astro";
import ProjectTechnologies from "@/components/project/ProjectTechnologies.astro";
import ProjectHiglights from "@/components/project/ProjectHiglights.astro";

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}
// 2. For your template, you can get the entry directly from the prop
const { project } = Astro.props;
const {
  title,
  description,
  highlights,
  tools,
  tags,
  demoUrl,
  sourceCodeUrl,
  image,
  mediaUrls,
} = project.data;
---

<BaseLayout>
  <div class="max-w-8xl mx-auto w-full flex flex-col gap-8 px-12 sm:px-14 py-8">
    <a
      href="/#projects"
      class="hover:text-primary transition-all w-fit bg-transparent hover:bg-transparent hover:shadow-none hover:drop-shadow-none hover:scale-110 duration-300"
    >
      <p>← Back to Projects</p>
    </a>
    <ProjectCardDetail
      description={description}
      title={title}
      demoUrl={demoUrl}
      mediaUrls={mediaUrls}
      sourceCodeUrl={sourceCodeUrl}
      image={image}
      tags={tags}
    />

    <div class="flex gap-10 relative">
      <ProjectHiglights highlights={highlights} />
      <ProjectTechnologies tools={tools} />
    </div>
  </div>
</BaseLayout>
