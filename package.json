{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm sync:open-source && astro build",
    "preview": "astro preview",
    "sync:open-source": "node scripts/sync-open-source.mjs",
    "test:size": "bundlewatch",
    "astro": "astro"
  },
  "bundlewatch": {
    "files": [
      {
        "path": "dist/_astro/*.js",
        "maxSize": "100kB"
      },
      {
        "path": "dist/_astro/*.css",
        "maxSize": "20kB"
      }
    ],
    "ci": {
      "trackBranches": [
        "new-portfolio"
      ]
    }
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/react": "^5.0.3",
    "@tailwindcss/vite": "^4.2.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "animejs": "^4.4.1",
    "astro": "^6.1.5",
    "astro-icon": "^1.1.5",
    "boxen": "^8.0.1",
    "cli-table3": "^0.6.5",
    "mdx": "^0.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "reveal.js": "^6.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "yoctocolors": "^2.1.2"
  },
  "devDependencies": {
    "@iconify-json/akar-icons": "^1.2.7",
    "@iconify-json/devicon": "^1.2.61",
    "@iconify-json/iconamoon": "^1.2.2",
    "@iconify-json/lineicons": "^1.2.6",
    "@iconify-json/lucide": "^1.2.98",
    "@iconify-json/material-icon-theme": "^1.2.60",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.74",
    "@iconify-json/skill-icons": "^1.2.4",
    "@iconify-json/weui": "^1.2.4",
    "@iconify/react": "^6.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/reveal.js": "^5.2.2",
    "bundlewatch": "^0.4.2",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3"
  }
}
